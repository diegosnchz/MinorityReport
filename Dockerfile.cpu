# Usamos una imagen ligera de Python 3.9 (Standard)
FROM python:3.9-slim

# Evita que Python genere archivos .pyc y buffer de salida
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Directorio de trabajo dentro del contenedor
WORKDIR /code

# Instalamos dependencias del sistema (Minimo necesario para CPU)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copiamos los requerimientos CPU e instalamos
COPY requirements-cpu.txt /code/requirements.txt
RUN pip install --no-cache-dir --upgrade -r requirements.txt

# Copiamos todo el código del proyecto
COPY ./app /code/app
# Tambien copiamos hpc_core si es necesario, segun estructura explorada
COPY ./hpc_core /code/hpc_core
COPY ./ai_engine /code/ai_engine

# Exponemos el puerto
EXPOSE 8000

# Variable de entorno para activar modo demo por defecto en este container
ENV DEMO_MODE=True

# Comando de inicio
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
